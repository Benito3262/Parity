# ─── Binance Web3 Wallet / Tokenized Stocks API ─────────────────────────────
# Leave empty for hybrid mode (Yahoo + DexScreener + PancakeSwap).
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Force fixture mock (old demo data): "true"
FORCE_FIXTURE_MOCK=false
# Force mock even if keys are set: "true" | "false"
BINANCE_WEB3_USE_MOCK=true
# Set true to use LiveBinanceWeb3Client when keys are present (same as USE_MOCK=false)
BINANCE_LIVE=false
# Optional override (default https://web3.binance.com/build)
# BINANCE_WEB3_BASE_URL=

# ─── Market data ────────────────────────────────────────────────────────────
# CoinMarketCap Pro key (server-only). Optional — DexScreener used as fallback.
CMC_API_KEY=
# Alias accepted:
# COINMARKETCAP_API_KEY=
# Optional Finnhub (not required; Yahoo is default for stock closes)
# FINNHUB_API_KEY=

# ─── BSC / PancakeSwap ──────────────────────────────────────────────────────
# Public BSC RPC for quotes + eth_call simulate (fallback: public seeds)
BSC_RPC_URL=https://bsc-dataseed.binance.org

# ─── App / wallet ───────────────────────────────────────────────────────────
# BSC mainnet chain id = 56
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_APP_NAME=Parity

# WalletConnect / Reown Cloud project id (https://cloud.walletconnect.com)
# Required for iPhone / mobile wallets. Safe in NEXT_PUBLIC_*.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical app origin for WalletConnect / Reown Verify metadata.url
NEXT_PUBLIC_APP_URL=https://parity-three-tau.vercel.app
