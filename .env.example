# Binance Web3 Wallet / Tokenized Stocks API
# Leave empty for mock mode (default). Fill when you have keys.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Force mock client even if keys are set: "true" | "false"
BINANCE_WEB3_USE_MOCK=true

# Network (spot only — no perps)
# BSC mainnet chain id = 56
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_APP_NAME=Parity

# WalletConnect / Reown Cloud project id (https://cloud.walletconnect.com)
# Required for iPhone / mobile wallets (Zerion, MetaMask app, Trust, Rainbow).
# Without it, only injected browser extensions work — mobile users see no real options.
# Project ids are public client config (safe in NEXT_PUBLIC_*).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical app origin for WalletConnect / Reown Verify metadata.url
# Must EXACTLY match the origin users open (and the Reown domain allowlist).
NEXT_PUBLIC_APP_URL=https://parity-three-tau.vercel.app

